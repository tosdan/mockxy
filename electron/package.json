{
  "name": "mockxy-desktop",
  "version": "1.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Guscio Electron dell'app desktop di Mockxy Mock Server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tosdan/mockxy.git",
    "directory": "electron"
  },
  "homepage": "https://github.com/tosdan/mockxy#readme",
  "bugs": {
    "url": "https://github.com/tosdan/mockxy/issues"
  },
  "author": "Mockxy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:deb": "electron-builder --config scripts/electron-builder.deb.js --linux deb --x64 --publish never",
    "dist:nsis": "electron-builder --config scripts/electron-builder.nsis.js --win nsis --x64 --publish never",
    "dist:appx:test": "electron-builder --config scripts/electron-builder.appx-test.js --win appx --x64 --publish never",
    "dist:appx:store": "electron-builder --config scripts/electron-builder.appx-store.js --win appx --x64 --publish never"
  },
  "dependencies": {
    "@scalar/openapi-parser": "^0.28.7",
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "js-yaml": "^3.14.1",
    "openapi-sampler": "^1.7.4",
    "path-to-regexp": "^8.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mockxy.desktop",
    "productName": "Mockxy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!scripts/**/*",
      "!store-identity*.json",
      {
        "from": "../src",
        "to": "src"
      }
    ],
    "extraResources": [
      {
        "from": "../mockxy-ui/dist/mockxy-ui/browser",
        "to": "ui"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Mockxy-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development"
    },
    "appImage": {
      "artifactName": "Mockxy-${version}-x86_64.AppImage"
    }
  }
}
